# ==========================================
# TELEGRAM (BotFather & Supergrupo/Tópicos)
# ==========================================
TELEGRAM_TOKEN=seu_token_do_botfather_aqui
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Tópicos do Grupo "diquinhas & promos 🎀✨"
THREAD_ID_PROTETOR_SOLAR=11
THREAD_ID_HIDRATANTE=7
THREAD_ID_LIMPEZA_FACIAL=14
THREAD_ID_SERUNS_E_ACIDOS=16
THREAD_ID_KBEAUTY=18
THREAD_ID_BELEZA_PREMIUM=243
THREAD_ID_OFERTAS=181

# Tópicos dos Containers do Mercado Livre
THREAD_ID_ROSTO_E_CORPO=11
THREAD_ID_CABELO=16
THREAD_ID_UNHAS=14
THREAD_ID_MODA=7

# Aliases de compatibilidade
THREAD_ID_SKINCARE=11
THREAD_ID_TECNOLOGIA=181

# ==========================================
# MERCADO LIVRE AFILIADOS
# ==========================================
ML_MATT_TOOL=seu_matt_tool
ML_MATT_WORD=seu_matt_word

# ==========================================
# SHOPEE AFILIADOS (opcional)
# ==========================================
SHOPEE_AFFILIATE_ID=seu_shopee_affiliate_id_aqui
# Open API de Afiliados (affiliate.shopee.com.br > Open API): preço, desconto, nota e foto do tópico Ofertas
SHOPEE_APP_KEY=seu_shopee_app_id_aqui
SHOPEE_APP_SECRET=seu_shopee_app_secret_aqui

# ==========================================
# PAINEL WEB (opcional)
# ==========================================
# Mantenha 127.0.0.1 e acesse por túnel SSH; 0 em PAINEL_ATIVO desliga o painel
PAINEL_ATIVO=1
PAINEL_HOST=127.0.0.1
PAINEL_PORTA=8080

# API oficial do Mercado Livre
ML_CLIENT_ID=seu_client_id
ML_CLIENT_SECRET=seu_client_secret

# ==========================================
# INSTAGRAM
# ==========================================
# @ da página, sem o @ (aparece no topo dos cards do carrossel)
INSTAGRAM_ARROBA=sua_pagina_aqui
# Posts: 0 desliga. Horários de publicação na ordem Vale a pena?, Dica, Top do dia
# (cada um é preparado 1h antes e só vai ao ar se for aprovado no painel)
INSTAGRAM_ATIVO=1
INSTAGRAM_HORARIOS=11:30,17:30,21:00
# Aviso no privado do Telegram 30 min antes, se o post não foi aprovado:
# id da conversa privada com o bot (mande /start para o bot) e o endereço https do painel
TELEGRAM_ADMIN_CHAT_ID=
PAINEL_URL=https://seu-servidor.sua-tailnet.ts.net
# Publicação automática (API do Instagram com login unificado). Sem as três, o aprovado sai à mão.
# Token do usuário do sistema (Portfólio > Usuários do sistema, expiração "Nunca"), com
# instagram_basic e instagram_content_publish; id da conta do Instagram (17841…)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Endereço público dos cards: o servidor de imagens (MIDIA_PORTA) publicado pelo Tailscale Funnel
# (tailscale funnel --bg --https=8443 8081). A Meta baixa as imagens daqui.
META_MIDIA_URL=https://seu-servidor.sua-tailnet.ts.net:8443
MIDIA_PORTA=8081

# ==========================================
# GEMINI (tema e legenda dos carrosséis; sem chave, usa o texto padrão)
# ==========================================
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
# GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.8-flash
