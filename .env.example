# ==========================================
# TELEGRAM (BotFather & Supergrupo/Tópicos)
# ==========================================
TELEGRAM_TOKEN=seu_token_do_botfather_aqui
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Tópicos do Grupo "diquinhas & promos 🎀✨"
THREAD_ID_PROTETOR_SOLAR=11
THREAD_ID_HIDRATANTE=7
THREAD_ID_LIMPEZA_FACIAL=14
THREAD_ID_SERUNS_E_ACIDOS=16
THREAD_ID_KBEAUTY=18
THREAD_ID_BELEZA_PREMIUM=243
THREAD_ID_OFERTAS=181

# Tópicos dos Containers do Mercado Livre
THREAD_ID_ROSTO_E_CORPO=11
THREAD_ID_CABELO=16
THREAD_ID_UNHAS=14
THREAD_ID_MODA=7

# Aliases de compatibilidade
THREAD_ID_SKINCARE=11
THREAD_ID_TECNOLOGIA=181

# ==========================================
# MERCADO LIVRE AFILIADOS
# ==========================================
ML_MATT_TOOL=seu_matt_tool
ML_MATT_WORD=seu_matt_word

# ==========================================
# SHOPEE AFILIADOS (opcional)
# ==========================================
SHOPEE_AFFILIATE_ID=seu_shopee_affiliate_id_aqui
# Open API de Afiliados (affiliate.shopee.com.br > Open API): preço, desconto, nota e foto do tópico Ofertas
SHOPEE_APP_KEY=seu_shopee_app_id_aqui
SHOPEE_APP_SECRET=seu_shopee_app_secret_aqui

# ==========================================
# PAINEL WEB (opcional)
# ==========================================
# Mantenha 127.0.0.1 e acesse por túnel SSH; 0 em PAINEL_ATIVO desliga o painel
PAINEL_ATIVO=1
PAINEL_HOST=127.0.0.1
PAINEL_PORTA=8080

# API oficial do Mercado Livre
ML_CLIENT_ID=seu_client_id
ML_CLIENT_SECRET=seu_client_secret
